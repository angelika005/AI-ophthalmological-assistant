# ==========================================
# Environment Variables Configuration
# For Local Development & Docker Deployment
# ==========================================

# ========== Frontend Configuration ==========
# Base URL for API calls (no trailing slash)
REACT_APP_API_URL=http://localhost:8000
# Node environment
NODE_ENV=development

# ========== Backend Configuration ==========

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Port Configuration
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=glaucoma_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@db:5432/glaucoma_db

# JWT & Authentication
SECRET_KEY=your-super-secret-key-change-this-in-production-12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost,http://127.0.0.1:3000,http://127.0.0.1

# MinIO/S3 Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET_NAME=glaucoma-images

# pgAdmin Configuration
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# External APIs
OPENWEATHER_API_KEY=your_openweather_api_key_optional

# ==========================================
# IMPORTANT SECURITY NOTES
# ==========================================
# 1. NEVER commit .env file with real values to git
# 2. Use .gitignore to exclude .env files
# 3. For production, use strong passwords and secret keys
# 4. Rotate secrets regularly
# 5. Use environment-specific .env files:
#    - .env.local for local development
#    - .env.production for production deployment
#    - .env.test for testing
# 6. Store sensitive values in secure vaults (AWS Secrets Manager, HashiCorp Vault, etc.)

